# ---------------------------------------------------------------------------
# Model provider — Core42 Compass (primary)
#
# In production this points at the APIM AI Gateway rather than Compass
# directly, so PII redaction, content safety and cost caps sit in the path.
#
# REAL AGENTS ARE THE DEFAULT. Without a key the backend refuses to start,
# because a stubbed run still produces a design pack carrying a
# recommendation — a misconfigured key must fail loudly, not answer with
# placeholders. Set ALLOW_STUB_AGENTS=true below to run without a model on
# purpose.
#
# TO ENABLE REAL AGENTS:
#   1. copy this file to  backend/.env   (that file is gitignored)
#   2. paste the key after COMPASS_API_KEY=  — no quotes, no spaces
#   3. verify with:  python -m tests.compass_check
#
# Never paste the key into a chat, a commit, a document or a screenshot.
# ---------------------------------------------------------------------------
COMPASS_API_BASE_URL=https://api.core42.ai/v1
COMPASS_API_KEY=
COMPASS_CHAT_MODEL=gpt-5.1
COMPASS_EMBEDDING_MODEL=text-embedding-3-large

# Azure AI Foundry (alternate — per-service managed identity)
USE_ENTRA_ID=false
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o

# ---------------------------------------------------------------------------
# Determinism — reproducibility is the product, not a tuning preference
#
# MODEL_SAMPLING_CONTROLS: auto | true | false
#   Reasoning models (gpt-5.x, o1, o3, o4) reject temperature and seed and
#   return 400 if either is sent. "auto" detects this from the model name.
#   With those models reproducibility rests on the schema gate and
#   version-pinned retrieval instead; /api/health reports which is active.
# ---------------------------------------------------------------------------
MODEL_TEMPERATURE=0
MODEL_SEED=42
MODEL_SAMPLING_CONTROLS=auto
SCHEMA_GATE_RETRIES=2

# ---------------------------------------------------------------------------
# Stub mode — opt in, never a fallback
#
# true  = run the 14 agentic steps as schema-valid placeholders. Every such
#         step is marked is_stub and /api/health reports stub_mode_waived.
#         For demos, offline work and CI.
# false = a missing or unusable model provider is a startup error.
#
# The tests set this for themselves; do not enable it for a deployment you
# intend anyone to read the output of.
# ---------------------------------------------------------------------------
ALLOW_STUB_AGENTS=false

# ---------------------------------------------------------------------------
# Governed artifacts
#
# FAIL_CLOSED must stay true outside unit tests: a stale or missing
# artifact stops the step rather than silently defaulting.
# ALLOW_SEED_ARTIFACTS stays true until M42 delivers governed versions.
# ---------------------------------------------------------------------------
ARTIFACT_ROOT=../artifacts
FAIL_CLOSED=true
ALLOW_SEED_ARTIFACTS=true

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
PERSISTENCE_MODE=local
COSMOS_ENDPOINT=
COSMOS_DATABASE=intake
LOCAL_STATE_DIR=./.state

# ---------------------------------------------------------------------------
# Capability registry (Azure AI Search) — the 525-tile registry
# ---------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=capability-registry-v2
AZURE_SEARCH_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
